# ────────────────────────────────────────────────────────────
# CRM_test — TEST environment (QNAP)
# Copy to .env.test (gitignored) and fill in the secrets, OR run ./make-env.sh
# Points at the SalesFlowCRM_test DB copy — safe for destructive CRUD testing.
# ────────────────────────────────────────────────────────────

NODE_ENV=production

# Same SQL Server instance, but the *_test database copy.
# NOTE: single backslash before the instance name (env_file is literal, unlike
# YAML which needs \\). Get the password from the prod deployment / your vault.
DATABASE_URL=sqlserver://172.28.10.2\MFILES_SQL;database=SalesFlowCRM_test;user=salesflow_app;password=YOUR_DB_PASSWORD;encrypt=true;trustServerCertificate=true

# Fresh, test-only secret: openssl rand -base64 32  (do NOT reuse the prod one)
NEXTAUTH_SECRET=replace-with-a-long-random-test-secret

# The URL testers use to reach CRM_test (QNAP firewall must allow port 3001). No trailing slash.
NEXTAUTH_URL=http://192.168.1.197:3001

# ── AD/LDAP (same as prod so login works) ──
LDAP_URL=ldap://172.28.10.1:389
LDAP_UPN_SUFFIX=shiluv.co.il
LDAP_NETBIOS=SHILUV
LDAP_BIND_MODE=upn
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_AUTO_PROVISION=false
