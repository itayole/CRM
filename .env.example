# ────────────────────────────────────────────────────────────
# SalesFlow CRM — Environment Variables
# Copy to .env and fill in the values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────

# MSSQL connection string (Prisma sqlserver provider)
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
# For Docker: replace HOST with host.docker.internal to reach host machine's MSSQL
DATABASE_URL="sqlserver://localhost:1433;database=SalesFlowCRM;user=salesflow_app;password=YOUR_STRONG_PASSWORD;encrypt=true;trustServerCertificate=true"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# The public URL of this app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API (for AI features — server-side only)
ANTHROPIC_API_KEY="sk-ant-..."
