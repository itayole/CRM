# ────────────────────────────────────────────────────────────
# SalesFlow CRM — Environment Variables
# Copy to .env and fill in the values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────

# MSSQL connection string (Prisma sqlserver provider)
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
# For Docker: replace HOST with host.docker.internal to reach host machine's MSSQL
# Named instance uses a dynamic port — query SQL Browser (UDP 1434) to find it:
# PowerShell: [System.Net.Sockets.UdpClient] query to host:1434 returns the tcp port
# Example: mfiles_SQL instance on 172.28.10.2 answered with tcp;61754
DATABASE_URL="sqlserver://YOUR_HOST:YOUR_PORT;database=SalesFlowCRM;user=salesflow_app;password=YOUR_STRONG_PASSWORD;encrypt=true;trustServerCertificate=true"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# The public URL of this app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API (for AI features — server-side only)
# NOTE: AI features (AI Assistant) are currently DISABLED/removed from the UI.
# This key is unused until they are re-enabled; the @anthropic-ai/sdk dep is kept for that.
ANTHROPIC_API_KEY="sk-ant-..."

# ────────────────────────────────────────────────────────────
# Active Directory / LDAP authentication
# Login accepts EITHER a local bcrypt password on the users row OR an AD bind.
# Leave LDAP_URL empty to disable LDAP and use local passwords only.
# ────────────────────────────────────────────────────────────
# Dev (internal LAN, cleartext): ldap://172.28.10.1:389
# Prod (enable LDAPS on the DC first):        ldaps://dc.shiluv.co.il:636
LDAP_URL="ldap://172.28.10.1:389"
# Appended to a bare username to form a UPN (e.g. "itay-admin" -> "itay-admin@shiluv.co.il").
# NOTE: some accounts' real UPN is @shiluv-i2r.com — those users must log in with their full UPN.
LDAP_UPN_SUFFIX="shiluv.co.il"
# Used only when LDAP_BIND_MODE=netbios
LDAP_NETBIOS="SHILUV"
# "upn" (default) or "netbios"
LDAP_BIND_MODE="upn"
# Set to "false" to accept a self-signed DC certificate over ldaps://
LDAP_TLS_REJECT_UNAUTHORIZED="true"
# Auto-create a sales_rep CRM row on first successful AD login (admins set manually)
LDAP_AUTO_PROVISION="false"
