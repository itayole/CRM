# ────────────────────────────────────────────────────────────
# SalesFlow CRM — TEST environment
# Copy to .env.test (gitignored) and fill in the secrets.
# Used by docker-compose.test.yml. Points at the SalesFlowCRM_test DB copy,
# NOT production — safe for destructive CRUD testing.
# ────────────────────────────────────────────────────────────

NODE_ENV=production

# Same SQL Server instance, but the *_test database copy you restored.
# (named instance uses a dynamic port — or use host:port directly)
# NOTE: single backslash before the instance name (env_file is literal, unlike YAML which needs \\)
DATABASE_URL="sqlserver://172.28.10.2\MFILES_SQL;database=SalesFlowCRM_test;user=salesflow_app;password=YOUR_DB_PASSWORD;encrypt=true;trustServerCertificate=true"

# Generate a fresh one: openssl rand -base64 32  (do NOT reuse the prod secret)
NEXTAUTH_SECRET="replace-with-a-long-random-test-secret"

# The URL testers use to reach the TEST app on the QNAP (note the :3001 port). No trailing slash.
NEXTAUTH_URL="http://192.168.1.197:3001"

# ── AD/LDAP (same as prod so login works in test) ──
LDAP_URL="ldap://172.28.10.1:389"
LDAP_UPN_SUFFIX="shiluv.co.il"
LDAP_NETBIOS="SHILUV"
LDAP_BIND_MODE="upn"
LDAP_TLS_REJECT_UNAUTHORIZED="true"
LDAP_AUTO_PROVISION="false"
