generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int             @id @default(autoincrement())
  name      String          @db.NVarChar(200)
  email     String          @unique @db.NVarChar(320)
  password  String?         @db.NVarChar(200)  // null = AD/LDAP-only login (no local password)
  role      String          @db.NVarChar(50)   // "admin" | "sales_rep"
  active    Boolean         @default(true)
  joined    DateTime        @default(now())
  lastLogin DateTime?
  leads     Lead[]          @relation("LeadAssignee")
  deals     Deal[]          @relation("DealAssignee")
  clients   Client[]        @relation("ClientAssignee")
  projects  Project[]       @relation("ProjectAssignee")
  contacts  Contact[]       @relation("ContactAccountMgr")
  tasks     Task[]          @relation("TaskAssignee")
  calEvents CalendarEvent[]

  @@map("users")
}

model Lead {
  id         Int      @id @default(autoincrement())
  name       String   @db.NVarChar(200)
  company    String   @db.NVarChar(200)
  email      String?  @db.NVarChar(320)
  phone      String?  @db.NVarChar(30)
  status     String   @db.NVarChar(20)   // "new"|"contacted"|"qualified"|"disqualified"
  score      Int      @default(0)
  value      Decimal  @db.Decimal(18, 2)
  source     String?  @db.NVarChar(50)
  assigneeId Int
  notes      String?  @db.NVarChar(Max)
  created    DateTime @default(now())
  activity   String?  @db.NVarChar(Max)  // JSON: [{type,text,time,user}]
  assignee   User     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company])
  @@index([phone])
  @@index([assigneeId])
  @@map("leads")
}

model Deal {
  id          Int           @id @default(autoincrement())
  title       String        @db.NVarChar(300)
  company     String        @db.NVarChar(200)
  clientId    Int?
  value       Decimal       @db.Decimal(18, 2)
  probability Int
  pipelineId  Int
  stageId     Int
  assigneeId  Int
  closeDate   DateTime?
  health      Int           @default(60)
  // NoAction throughout: avoids MSSQL multiple-cascade-path conflicts
  // (Deal reaches Pipeline directly and indirectly via PipelineStage / Client).
  assignee    User          @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stage       PipelineStage @relation("DealStage", fields: [stageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pipelineId])
  @@index([stageId])
  @@index([assigneeId])
  @@map("deals")
}

// ── Configuration: multiple sales pipelines, each with ordered stages ────────
model Pipeline {
  id        Int             @id @default(autoincrement())
  name      String          @db.NVarChar(100)
  isDefault Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  stages    PipelineStage[]
  deals     Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          Int      @id @default(autoincrement())
  pipelineId  Int
  label       String   @db.NVarChar(100)
  order       Int      @default(0)
  color       String?  @db.NVarChar(7)
  probability Int      @default(0)   // win probability % at this stage
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  active      Boolean  @default(true)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]   @relation("DealStage")

  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ── Configuration: generic admin-editable taxonomies ────────────────────────
// category: "lead_status" | "lead_source" | "task_type" | "project_status"
model ConfigOption {
  id       Int     @id @default(autoincrement())
  category String  @db.NVarChar(50)
  key      String  @db.NVarChar(50)
  label    String  @db.NVarChar(100)
  color    String? @db.NVarChar(7)
  order    Int     @default(0)
  active   Boolean @default(true)

  @@unique([category, key])
  @@index([category])
  @@map("config_options")
}

model Client {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.NVarChar(200)
  mfilesClientNo Int?            @unique            // external M-Files client number (sync key)
  industry       String?         @db.NVarChar(50)
  email          String?         @db.NVarChar(320)
  phone          String?         @db.NVarChar(30)
  address        String?         @db.NVarChar(300)
  website        String?         @db.NVarChar(200)
  size           String?         @db.NVarChar(20)   // "1-10"|"10-50"|"50-200"|"200+"
  status         String?         @db.NVarChar(20)   // "active"|"prospect"
  since          DateTime?
  assigneeId     Int?                               // account manager (CRM user)
  notes          String?         @db.NVarChar(Max)
  assignee       User?           @relation("ClientAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts       ClientContact[]
  contactPeople  Contact[]
  projects       Project[]
  deals          Deal[]

  @@map("clients")
}

model ClientContact {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @db.NVarChar(200)
  role        String?   @db.NVarChar(100)
  email       String?   @db.NVarChar(320)
  phone       String?   @db.NVarChar(30)
  main        Boolean   @default(false)
  lastContact DateTime?
  deals       Int       @default(0)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model Project {
  id               Int             @id @default(autoincrement())
  clientId         Int?
  contactId        Int?
  name             String          @db.NVarChar(300)
  desc             String?         @db.NVarChar(Max)
  status           String?         @db.NVarChar(20)   // "planning"|"active"|"paused"|"completed"
  priority         String?         @db.NVarChar(10)   // "high"|"medium"|"low"
  budget           Decimal?        @db.Decimal(18, 2)
  spent            Decimal         @default(0)        @db.Decimal(18, 2)
  progress         Int             @default(0)
  startDate        DateTime?
  endDate          DateTime?
  assigneeId       Int?                               // account manager (CRM user)
  tags             String?         @db.NVarChar(500)  // JSON: ["tag1","tag2"]
  // ── M-Files project attributes (synced from M-Files) ──
  projectNo        Int?            @unique            // M-Files project number (sync key)
  shiluvNo         String?         @db.NVarChar(50)
  clientName       String?         @db.NVarChar(200)  // raw client name from M-Files (pre name-match)
  model            String?         @db.NVarChar(100)
  methodology      String?         @db.NVarChar(100)  // e.g. "כמותי" / "איכותני"
  state            String?         @db.NVarChar(100)
  statusText       String?         @db.NVarChar(100)
  abc              String?         @db.NVarChar(10)
  tpName           String?         @db.NVarChar(200)
  questionsCount   Int?
  billing          Decimal?        @db.Decimal(18, 2)
  proposalDate     DateTime?
  approvalDate     DateTime?
  cancelledDate    DateTime?
  billingDate      DateTime?
  actualEndDate    DateTime?
  relevantDate     DateTime?
  lastUpdated      DateTime?
  sourceCreatedAt  DateTime?
  researchTypeId   Int?
  researchMethodId Int?
  productId        Int?
  // NoAction throughout: avoids MSSQL multiple-cascade-path conflicts.
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee         User?           @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  researchType     ResearchType?   @relation(fields: [researchTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  researchMethod   ResearchMethod? @relation(fields: [researchMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  phases           ProjectPhase[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([researchTypeId])
  @@index([researchMethodId])
  @@index([productId])
  @@map("projects")
}

model ProjectPhase {
  id        Int       @id @default(autoincrement())
  projectId Int
  name      String    @db.NVarChar(200)
  status    String    @db.NVarChar(20)   // "pending"|"active"|"done"|"blocked"
  startDate DateTime?
  endDate   DateTime?
  budget    Decimal   @default(0) @db.Decimal(18, 2)
  spent     Decimal   @default(0) @db.Decimal(18, 2)
  notes     String?   @db.NVarChar(Max)
  order     Int       @default(0)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_phases")
}

model Task {
  id         Int      @id @default(autoincrement())
  desc       String   @db.NVarChar(500)
  type       String   @db.NVarChar(20)   // "call"|"email"|"meeting"|"proposal"|"followup"|"other"
  priority   String   @db.NVarChar(10)   // "high"|"medium"|"low"
  date       DateTime
  time       String?  @db.NVarChar(5)
  client     String?  @db.NVarChar(200)
  notes      String?  @db.NVarChar(Max)
  status     String   @db.NVarChar(10)   // "open"|"done"
  assigneeId Int
  created    DateTime @default(now())
  assignee   User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigneeId, status])
  @@map("tasks")
}

model CalendarEvent {
  id         Int      @id @default(autoincrement())
  title      String   @db.NVarChar(400)
  date       DateTime
  time       String?  @db.NVarChar(5)
  endTime    String?  @db.NVarChar(5)
  type       String   @db.NVarChar(20)   // "meeting"|"call"|"demo"|"task"|"other"
  assigneeId Int
  client     String?  @db.NVarChar(200)
  notes      String?  @db.NVarChar(Max)
  location   String?  @db.NVarChar(300)
  color      String?  @db.NVarChar(7)
  gcEventId  String?  @db.NVarChar(200)
  assignee   User     @relation(fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigneeId, date])
  @@map("calendar_events")
}

model Automation {
  id      Int     @id @default(autoincrement())
  name    String  @db.NVarChar(200)
  trigger String  @db.NVarChar(300)
  action  String  @db.NVarChar(300)
  active  Boolean @default(true)
  runs    Int     @default(0)

  @@map("automations")
}

model LeadIntegration {
  id           Int     @id @default(autoincrement())
  sourceId     String  @unique @db.NVarChar(50)
  label        String  @db.NVarChar(100)
  method       String  @db.NVarChar(20)           // "webhook"|"polling"
  status       String  @db.NVarChar(20)           // "active"|"inactive"
  pollInterval String? @db.NVarChar(50)
  accessToken  String? @db.NVarChar(Max)          // AES-256 encrypted at app layer
  webhookUrl   String? @db.NVarChar(500)
  fieldMapping String? @db.NVarChar(Max)          // JSON: {"full_name":"name"}
  totalLeads   Int     @default(0)
  todayLeads   Int     @default(0)

  @@map("lead_integrations")
}

// ── M-Files synced data ──────────────────────────────────────────────────────
// Standalone contacts imported from M-Files (active / raw / unsubscribed sheets).
model Contact {
  id               Int      @id @default(autoincrement())
  mfilesId         Int?     @unique                  // M-Files object id (sync key)
  fullName         String?  @db.NVarChar(200)
  firstName        String?  @db.NVarChar(100)
  email            String?  @db.NVarChar(320)
  mobile           String?  @db.NVarChar(40)
  companyName      String?  @db.NVarChar(200)        // raw company name from M-Files (pre name-match)
  category         String?  @db.NVarChar(200)
  newsletterType   String?  @db.NVarChar(100)
  newsletter       Boolean  @default(false)
  status           String?  @db.NVarChar(30)         // "active" | "raw" | "unsubscribed"
  clientId         Int?
  accountManagerId Int?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accountManager   User?    @relation("ContactAccountMgr", fields: [accountManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email])
  @@index([companyName])
  @@index([clientId])
  @@map("contacts")
}

// Lookup tables synced from M-Files (referenced by Project).
model Product {
  id       Int       @id @default(autoincrement())
  mfilesId Int?      @unique
  name     String    @db.NVarChar(300)
  active   Boolean   @default(true)
  projects Project[]

  @@map("products")
}

model ResearchType {
  id       Int       @id @default(autoincrement())
  mfilesId Int?      @unique
  name     String    @db.NVarChar(200)
  active   Boolean   @default(true)
  projects Project[]

  @@map("research_types")
}

model ResearchMethod {
  id       Int       @id @default(autoincrement())
  mfilesId Int?      @unique
  name     String    @db.NVarChar(200)
  active   Boolean   @default(true)
  projects Project[]

  @@map("research_methods")
}
